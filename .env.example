# Copy this file to .env (or .env.local) and fill in the values. Never commit either file.
# Then run: pnpm seed:admin (creates your admin login) and pnpm seed (fills every section, English + Bangla).

# --- Required -----------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or local).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/portfolio

# The single admin account used by `pnpm seed:admin`.
ADMIN_EMAIL=you@example.com
# At least 12 characters.
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs the admin session cookie and salts rate-limit IP hashes. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters

# --- Optional -----------------------------------------------------------------

# Public URL of the site, used for canonical links, hreflang (English/Bangla) and structured data.
NEXT_PUBLIC_SITE_URL=https://nurmhm.dev

# AI project planner in the hero. Without a key, the planner shows a "send me your idea" fallback.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used by the planner (defaults to claude-haiku-5-5, the lowest-cost option).
BRIEF_MODEL=

# Email notification for every new lead, sent through Resend (https://resend.com).
RESEND_API_KEY=
# Inbox that receives the notifications.
LEAD_NOTIFY_EMAIL=
# Sender address on a domain verified in Resend, e.g. "Portfolio <leads@nurmhm.dev>".
# Defaults to Resend's test sender, which can only email your own Resend account address.
LEAD_FROM_EMAIL=
